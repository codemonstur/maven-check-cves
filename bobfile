include https://raw.githubusercontent.com/codemonstur/bobfiles/master/foss-lib-github-maven

vendor: com.github.codemonstur
name: maven-check-cves
version: 1.1.0
release: 17
description: A maven plugin for checking CVEs of dependencies
license:
  name: MIT
developer:
  name: Jurgen Voorneveld
  email: jegvoorneveld@gmail.com
enablePreview: false
packaging: maven-plugin
dependencies:
  - repository: org.apache.maven:maven-core:3.9.6
    scope: provided
  - repository: org.apache.maven:maven-plugin-api:3.9.6
    scope: provided
  - repository: org.apache.maven.plugin-tools:maven-plugin-annotations:3.13.1
    scope: provided
  - repository: com.google.code.gson:gson:2.14.0
  - repository: com.github.codemonstur:httpclient:1.2.2
  - repository: org.junit.jupiter:junit-jupiter:6.1.3
    scope: test

build
 |  mvn clean package -DskipTests

update
    mvn validate -P vulnerabilities
    mvn validate -P licenses